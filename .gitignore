# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.python-version

# Virtual environments
.venv/
venv/
env/

# Build artifacts
dist/
build/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment
.env

# Editor / OS
.idea/
.vscode/
.DS_Store

# Himmy Studio (frontend)
studio/node_modules/
studio/dist/
# Built SPA emitted into the package by `npm run build`; shipped in wheels via
# package-data, but not tracked in source control.
himmy/api/_studio_static/

# TypeScript incremental build info
studio/*.tsbuildinfo

# Local-only farm demo (not for GitHub — framework testing)
/examples/farm-studio/

# Local runtime data (traces, run store, sessions) — never publish
.himmy/

# Playwright MCP browser artifacts (local testing)
.playwright-mcp/

# Ad-hoc live-model verification scripts (drive a real local Ollama/Claude CLI — NOT
# pytest-collected, not part of the offline suite). Local-only; never committed.
tests/live/

# Scratch agent specs at the repo root (Studio's agent picker globs *.agent.yaml here).
# The tracked default.agent.yaml is the only committed one; these are local scratch.
/ollama-calc.agent.yaml
/personal-assistant.agent.yaml

# Deployment secrets & local env (deploy/compose/) — operator-provided, never
# committed. Keep the secrets/ dir itself (via .gitkeep) so the RO bind mount and
# the postgres_password file source have somewhere to land.
deploy/compose/secrets/*
!deploy/compose/secrets/.gitkeep
deploy/compose/.env
benchmarks/results/*.log

# Reconciliation reports (ephemeral working output; findings persist in
# docs/services/*.md + agent guidance, not in the report files).
docs/inference-reconciliation-reports/
docs/tools-reconciliation-reports/

# Generated external-benchmark run artifacts (tau2 / Berkeley-BFCL harnesses under
# scripts/). The harness SCRIPTS are committed; their run output (logs, pid files,
# file locks, scored results, jsonl turn dumps) is ephemeral and regenerated per run.
scripts/tau2/workdir/
scripts/real_bfcl/proj/.file_locks/
scripts/real_bfcl/proj/score/
scripts/real_bfcl/proj/result/

# --- local research/benchmark scaffolding + artifacts (kept on disk, not committed) ---
# Heavy/third-party benchmark harness checkouts + their run data:
scripts/real_bfcl/
scripts/tau2/
scripts/bfcl/
scripts/gemma4_server/
scripts/BENCHMARKING.md
# Generated benchmark result dumps:
benchmarks/results/
# Local red-team report notes + double-click launchers:
REDTEAM_FINAL_2026-06-25.md
REDTEAM_REPORT_2026-06-25.md
REDTEAM_STAGE2_REATTACK_2026-06-25.md
chat-himalaya.command

# internal red-team / hardening working reports (keep private)
RBAC_HARDENING_*.md
RBAC_REDTEAM_*.md
REDTEAM_*.md
EFFICIENCY_AUDIT_*.md
ENTERPRISE_STRATEGY_*.md
