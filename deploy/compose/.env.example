# =============================================================================
# Himmy Studio full-stack compose — environment template
# =============================================================================
# Copy to deploy/compose/.env and fill in. This file feeds env interpolation in
# deploy/compose/docker-compose.yml. The real .env is gitignored.
#
#   cp deploy/compose/.env.example deploy/compose/.env
#
# =============================================================================

# --- Image tag --------------------------------------------------------------
# Tag applied to the locally built Studio image (himmy-studio:<HIMMY_VERSION>).
# HIMMY_VERSION=0.1.0

# --- Postgres password (REQUIRED) -------------------------------------------
# !!! DUPLICATION NOTICE !!!
# The Postgres password must be set in TWO places with the SAME value:
#   1. POSTGRES_PASSWORD below  — interpolated into Studio's HIMMY_DATABASE_URL.
#   2. deploy/compose/secrets/postgres_password  — the file the Postgres server
#      reads via POSTGRES_PASSWORD_FILE (kept out of `docker inspect`).
# If the two diverge, Studio cannot authenticate to Postgres. Set both before
# the first `up`; changing it later also requires resetting the pg volume.
#
# Use a URL-SAFE (alphanumeric) password. It is interpolated raw into the DSN
# (postgresql://himmy:<pw>@postgres:5432/himmy), so @ : / # ? break URL parsing,
# and a literal $ is eaten by compose's own env interpolation. Avoid all of them.
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --- Studio loopback guard --------------------------------------------------
# Hosts allowed past the Studio loopback guard. localhost:8765 already passes;
# only set this when reaching Studio over a domain or through a reverse proxy —
# list the original Host header value(s), comma-separated. NEVER disable the
# guard (do not set HIMMY_STUDIO_GUARD=0).
# HIMMY_STUDIO_ALLOW_HOSTS=studio.example.com

# --- Auth hardening ---------------------------------------------------------
# Authentication mode. Recommended for any non-loopback exposure. Leave empty
# for open localhost-only use.
#   apikey  — require an internal API key header (set HIMMY_INTERNAL_API_KEY).
#   oidc    — validate OIDC bearer tokens (configure HIMMY_OIDC_* separately).
# HIMMY_AUTH_MODE=apikey
# HIMMY_INTERNAL_API_KEY=

# Comma-separated allowed CORS origins (only needed for a browser app on a
# different origin). Leave unset to keep CORS closed.
# HIMMY_CORS_ORIGINS=https://app.example.com

# --- Rate limiting (off unless HIMMY_RATE_LIMIT is set) ---------------------
# HIMMY_RATE_LIMIT  — sustained requests allowed per window.
# HIMMY_RATE_WINDOW — window length in seconds (default 1).
# HIMMY_RATE_BURST  — burst capacity (default: same as HIMMY_RATE_LIMIT).
# HIMMY_RATE_LIMIT=20
# HIMMY_RATE_WINDOW=1
# HIMMY_RATE_BURST=40

# --- Encryption-at-rest (the [encryption] extra) ----------------------------
# Base64 KEK for encrypting sensitive stored fields. This is an APP-MANAGED
# secret, not an env var fed to Postgres — put it in a file under
# deploy/compose/secrets/ named HIMMY_ENCRYPTION_KEY (that dir is RO-mounted at
# /run/himmy-secrets, where HIMMY_SECRETS=file reads it). Do NOT commit it.
#   echo -n "<base64-32-byte-key>" > deploy/compose/secrets/HIMMY_ENCRYPTION_KEY
