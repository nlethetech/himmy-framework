# OpenSims environment variables (copy to .env and fill in as needed).
# Everything below is OPTIONAL. With none of these set, OpenSims runs fully
# offline using the deterministic StubClientManager — no keys, no network.

# --- Providers (the [providers] extra: pydantic-ai) -------------------------
# OpenRouter-compatible provider key + model id, consumed by PydanticAIClientManager.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Model id used by the bundled examples when a real provider is available.
# OPENSIMS_EXAMPLES_MODEL=openai:gpt-4o-mini

# --- Pydantic AI Gateway (production routing) ------------------------------
# When set (with the [providers] extra installed), GatewayClientManager routes
# real model calls through the Pydantic AI Gateway.
# PYDANTIC_AI_GATEWAY_API_KEY=pag-...
# OPENSIMS_GATEWAY_REGION=us
# Set to simulate the gateway offline (falls back to the deterministic stub when
# no key/extra is present) — handy for local dev/tests without a real gateway.
# OPENSIMS_GATEWAY_STUB_FALLBACK=1

# --- API server hardening --------------------------------------------------
# When set, requests must carry the internal key header (see OPENSIMS_INTERNAL_HEADER).
# OPENSIMS_INTERNAL_API_KEY=
# OPENSIMS_INTERNAL_HEADER=x-opensims-internal-key

# --- Observability (the [observability] extra: logfire) --------------------
# OPENSIMS_LOGFIRE_ENABLED=false
# OPENSIMS_LOGFIRE_INCLUDE_CONTENT=false
# OPENSIMS_LOGFIRE_SERVICE_NAME=opensims

# --- Postgres (the [postgres] extra: asyncpg) ------------------------------
# When set, example 06 wires PostgresStorageService against this DSN.
# OPENSIMS_TEST_POSTGRES_DSN=postgresql://opensims:opensims@localhost:5433/opensims
# When set, ApiContainer.build_default_async() wires the API's storage to a
# Postgres-backed StorageService (durable background runs + idempotency across
# restarts/workers). create_app()/build_default() stay in-memory by default.
# OPENSIMS_DATABASE_URL=postgresql://opensims:opensims@localhost:5433/opensims

# --- OpenAI-compatible embeddings (the [knowledge] extra) ------------------
# Consumed by the knowledge embedder / multimodal model (explicit kwargs override).
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_EMBED_MODEL=
